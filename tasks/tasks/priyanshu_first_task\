        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load dataset (we'll add dataset.csv later in GitHub)\n",
        "data = {\n",
        "    \"name\": [\"Priyanshu\", \"Ankit\", \"Neha\"],\n",
        "    \"age\": [21, 22, 20],\n",
        "    \"score\": [85, 90, 78]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Show first rows\n",
        "print(df.head())\n",
        "\n",
        "# Plot histogram\n",
        "plt.hist(df[\"score\"])\n",
        "plt.xlabel(\"Score\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.title(\"Distribution of Scores\")\n",
        "plt.show()"
      ],
